# Project npm configuration (build machine only).
#
# `npm run stage` resolves @deepseek-ai/dsh from this registry, so the choice
# materially affects build speed and success. Replace it with your own if needed.
registry=https://registry.npmmirror.com

# electron-builder downloads its own toolchain (winCodeSign, nsis) on first run.
# Those mirror hints are NOT valid npm config keys -- npm warns about unknown
# keys here -- so pass them as environment variables instead:
#
#   $env:ELECTRON_MIRROR='https://registry.npmmirror.com/-/binary/electron/'
#   $env:ELECTRON_BUILDER_BINARIES_MIRROR='https://registry.npmmirror.com/-/binary/electron-builder-binaries/'
#   npm run dist
#
# scripts/stage-node.mjs reads DSH_NODE_MIRROR / DSH_NODE_VERSION, and
# scripts/stage-runtime.mjs reads DSH_STAGE_REGISTRY.

audit=false
fund=false
