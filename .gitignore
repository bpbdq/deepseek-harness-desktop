# 依赖与构建产物
node_modules/
dist/
release/
# 构建期由 `npm run stage` 生成：数百 MB，且可由
# scripts/stage-runtime.mjs + scripts/stage-node.mjs 完整复现，不入库。
runtime/
!runtime/.gitkeep

# 图标**必须入库**：macOS 打包要由它生成 .icns，CI 里缺了它会直接失败
# （这正是第一轮 macOS 构建失败的原因之一）。
# 想换正式品牌资源，替换 build/icon.png 后提交即可；需要重新生成占位图标时
# 执行 `npm run icon`。
!build/icon.png
!build/entitlements.mac.plist

# 开发期状态隔离目录（DSH_DESKTOP_HOME 指向这里）
.dev-home/
.dev-*/
.iso-*/
.packaged-home/
.sim-update-home/
.update-test/
.probe-home/
.collect-rehearsal/

# 版本递增的节流戳（防止调试期反复打包白吃版本号），属本机状态
.last-bump

# 排查过程的临时文件
probe/
*.log
*.tmp
.screen.png
.window.png
.zh.png
.zh-menu.png
.installed-zh.png

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
COMMIT_MSG.txt

# 调试探针的临时输出
.dev-err.txt
.dev-out.txt
.ui-check.png
.startup-capture.png

# 压缩/体积测量的临时产物
.pruned/
.pruned2/
.codecs.*
.measure.*
.aggr.*
